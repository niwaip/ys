# Local embedded PostgreSQL-compatible data directory; production may use a PostgreSQL URL.
DATABASE_URL=pglite://.data/ys
HOST=127.0.0.1
PORT=3001
YS_CUSTOMERS='[{"id":"acme","name":"星河科技"},{"id":"river","name":"远山集团"}]'
# Replace this placeholder locally with a random secret (at least 16 characters).
YS_OPERATORS='[{"token":"REPLACE_WITH_A_RANDOM_SECRET","name":"资产操作员","customerIds":["acme","river"]}]'
# Optional reviewed Pi + CVE skill runtime. Leave blank to show unavailable.
YS_PI_EXECUTABLE=
YS_CVE_SCRIPT=
# YS_PYTHON_EXECUTABLE=python3
# YS_AGENT_ARTIFACT_ROOT=.data/agent
# YS_PI_PROVIDER=
# YS_PI_MODEL=
# YS_PI_TERMINAL_EVENT=agent_settled
# Optional: enable real Trivy only after separately preparing a trusted binary and offline DB.
# YS_TRIVY_EXECUTABLE=/absolute/path/to/trivy
# YS_TRIVY_CACHE_DIR=/absolute/path/to/dedicated-trivy-cache
# YS_TRIVY_TIMEOUT_MS=120000
# Optional NetBox authority mode. Configure URL, private token and unique Tenant mapping together.
# YS_NETBOX_URL=http://127.0.0.1:8000/api/
# YS_NETBOX_TOKEN=REPLACE_LOCALLY
# YS_NETBOX_TENANTS={"acme":7,"river":8}
# YS_NETBOX_TIMEOUT_MS=15000
# Optional server-controlled SSH references; never put these paths or keys into prompts.
# YS_COLLECTION_PROFILES=[{"id":"host-read","label":"只读连接","customerId":"acme","assetId":"REPLACE_WITH_YS_ASSET_UUID","host":"host.example","username":"reader","identityFile":"/absolute/private/key","knownHostsFile":"/absolute/pinned/known_hosts","allowDocker":false}]

# Encrypted web-managed SSH credentials. Preserve master.key with the database backup.
# Default: <PGlite data directory>/access; PostgreSQL deployments should set a durable path.
# YS_COLLECTION_STORE=/var/lib/ys/access

# Optional deployment-host execution: explicitly bind to the permitted customer and existing asset.
# Local profiles need no SSH fields. Docker authorization stays off unless deliberately enabled.
# YS_COLLECTION_PROFILES=[{"id":"ys-local","label":"YS 部署主机","customerId":"acme","assetId":"REPLACE_WITH_YS_ASSET_UUID","transport":"local","allowDocker":false}]
