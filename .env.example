# Local embedded PostgreSQL-compatible data directory; production may use a PostgreSQL URL.
DATABASE_URL=pglite://.data/ys
HOST=127.0.0.1
PORT=3001
YS_CUSTOMERS='[{"id":"acme","name":"星河科技"},{"id":"river","name":"远山集团"}]'
# Replace this placeholder locally with a random secret (at least 16 characters).
YS_OPERATORS='[{"token":"REPLACE_WITH_A_RANDOM_SECRET","name":"资产操作员","customerIds":["acme","river"]}]'
# Optional reviewed Pi + CVE skill runtime. Leave blank to show unavailable.
YS_PI_EXECUTABLE=
YS_CVE_SCRIPT=
